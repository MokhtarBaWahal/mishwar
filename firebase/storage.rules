rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User Avatars
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Driver Documents (Sensitive: only driver & admin)
    match /driver_documents/{driverId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == driverId || request.auth.token.role == 'ADMIN');
      allow write: if request.auth != null && request.auth.uid == driverId;
    }

    // Vehicle Photos
    match /vehicles/{driverId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == driverId;
    }
  }
}
