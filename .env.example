# MISHWAR (مشوار) - Environment Variables Template
# Copy this file to .env.development, .env.staging, or .env.production

# Runtime Mode: demo | staging | pilot | production
APP_MODE=demo
VITE_APP_MODE=demo

# Capability Gates
USE_MOCK_DATA=true
USE_REAL_DATABASE=false
USE_REAL_AUTH=false
USE_REAL_GPS=false
USE_REAL_MAPS=false
USE_REAL_NOTIFICATIONS=false
USE_REAL_PAYMENT=false
VITE_USE_MOCK_DATA=true
VITE_USE_REAL_DATABASE=false
VITE_USE_REAL_AUTH=false
VITE_USE_REAL_GPS=false
VITE_USE_REAL_MAPS=false
VITE_USE_REAL_NOTIFICATIONS=false
VITE_USE_REAL_PAYMENT=false
VITE_ALLOW_DEMO_OTP=true
VITE_ALLOW_DEMO_ACCOUNTS=true
VITE_ALLOW_LOCAL_PERSISTENCE=true

# Server Configuration
PORT=3000
VITE_API_BASE_URL=http://localhost:4000/api
VITE_API_TOKEN=""
API_TOKEN=""
ALLOWED_ORIGINS="http://localhost:3000"

# Firebase Web App Credentials (From Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-web-app-id"

# Backend Firebase Admin SDK (Server-Side Only - Private Key)
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Google Maps Platform (Directions, Geocoding, Places)
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_BROWSER_KEY"
VITE_USE_MOCK_MAPS=true

# Pilot Configuration
VITE_PILOT_MODE=true
VITE_MAX_PILOT_DRIVERS=10
VITE_MAX_PILOT_CUSTOMERS=100
VITE_DEFAULT_CITY="Sana'a"
VITE_DEFAULT_CURRENCY="YER"
VITE_CASH_ONLY=true

# Feature Flags
VITE_ENABLE_WALLET=false
VITE_ENABLE_CARD=false
VITE_ENABLE_DELIVERY=false
VITE_ENABLE_CORPORATE=false
VITE_ENABLE_SOS=true
VITE_ENABLE_CHAT=true
